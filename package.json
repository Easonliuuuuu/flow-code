{
  "name": "@easonliuuuuu/flow-code",
  "version": "0.1.0",
  "description": "Terminal-native node-graph interface for running and observing agentic coding workflows",
  "license": "MIT",
  "homepage": "https://github.com/Easonliuuuuu/flow-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Easonliuuuuu/flow-code.git"
  },
  "bugs": {
    "url": "https://github.com/Easonliuuuuu/flow-code/issues"
  },
  "keywords": [
    "cli",
    "tui",
    "ink",
    "agent",
    "agentic",
    "workflow",
    "node-graph",
    "claude",
    "openai",
    "openrouter"
  ],
  "type": "module",
  "bin": {
    "flow-code": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.0"
  }
}
